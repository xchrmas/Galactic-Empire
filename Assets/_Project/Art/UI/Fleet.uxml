<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement name="root" picking-mode="Ignore" style="flex: 1; background-color: rgba(0,0,0,0);">

        <!-- Fleet list panel - always visible while this screen is shown -->
        <ui:VisualElement name="fleet-panel" picking-mode="Position"
            style="position: absolute; top: 80px; right: 20px; width: 300px;
                   background-color: rgba(10,20,40,0.9); padding: 16px;
                   border-color: rgba(100,180,255,0.4); border-width: 1px; border-radius: 4px;">

            <ui:Label text="Fleets"
                style="font-size: 18px; color: rgba(200,220,255,1); -unity-font-style: bold; margin-bottom: 10px;"/>

            <ui:ScrollView name="fleet-list" mode="Vertical"
                style="max-height: 260px; margin-bottom: 12px;"/>

            <ui:VisualElement name="create-section" style="margin-top: 4px;">
                <ui:Label text="Build New Fleet"
                    style="font-size: 12px; color: rgba(150,170,200,1); margin-bottom: 6px;"/>

                <ui:TextField name="fleet-name-field" label="Name" value=""
                    style="margin-bottom: 6px; font-size: 12px;"/>

                <ui:IntegerField name="ship-count-field" label="Ships" value="1"
                    style="margin-bottom: 8px; font-size: 12px;"/>

                <ui:ScrollView name="blueprint-list" mode="Vertical"
                    style="max-height: 180px; margin-bottom: 8px;"/>
            </ui:VisualElement>

            <ui:Label name="fleet-feedback" text=""
                style="font-size: 11px; color: rgba(255,180,100,1); margin-top: 8px; white-space: normal;"/>

        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
