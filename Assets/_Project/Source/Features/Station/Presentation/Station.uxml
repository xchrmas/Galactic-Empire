<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement name="root" picking-mode="Ignore" style="flex: 1; background-color: rgba(0,0,0,0);">

        <!-- Cell info panel - hidden until a grid cell is clicked -->
        <ui:VisualElement name="cell-panel" picking-mode="Position"
            style="position: absolute; top: 80px; right: 20px; width: 280px;
                   background-color: rgba(10,20,40,0.9); padding: 16px;
                   border-color: rgba(100,180,255,0.4); border-width: 1px; border-radius: 4px;
                   display: none;">

            <ui:Label name="cell-title" text="Cell (0,0)"
                style="font-size: 18px; color: rgba(200,220,255,1); -unity-font-style: bold; margin-bottom: 4px;"/>

            <ui:Label name="cell-status" text="Empty"
                style="font-size: 12px; color: rgba(180,180,200,1); margin-bottom: 12px;"/>

            <!-- Shown only when the cell is empty - pick a module to build -->
            <ui:VisualElement name="build-section" style="margin-bottom: 8px;">
                <ui:Label text="Available Modules"
                    style="font-size: 12px; color: rgba(150,170,200,1); margin-bottom: 6px;"/>

                <ui:ScrollView name="module-list" mode="Vertical"
                    style="max-height: 220px; margin-bottom: 8px;"/>
            </ui:VisualElement>

            <!-- Shown only when the cell already has a module -->
            <ui:VisualElement name="module-info-section" style="margin-bottom: 8px; display: none;">
                <ui:Label name="module-name" text="Module Name"
                    style="font-size: 14px; color: rgba(120,200,255,1); margin-bottom: 2px;"/>
                <ui:Label name="module-production" text="Production: -"
                    style="font-size: 12px; color: rgba(180,180,200,1); margin-bottom: 8px;"/>

                <ui:Button name="remove-button" text="REMOVE MODULE"
                    style="height: 32px; font-size: 12px; -unity-font-style: bold;
                           background-color: rgba(120,30,30,0.8); color: rgba(255,200,180,1);
                           border-color: rgba(255,100,100,0.4); border-width: 1px; border-radius: 3px;"/>
            </ui:VisualElement>

            <ui:Label name="station-feedback" text=""
                style="font-size: 11px; color: rgba(255,180,100,1); margin-top: 8px; white-space: normal;"/>

        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
